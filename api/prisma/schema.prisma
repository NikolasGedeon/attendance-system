generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id @default(uuid())
  fullName              String
  email                 String?                   @unique
  passwordHash          String?
  microsoftId           String?                   @unique
  role                  Role                      @default(EMPLOYEE)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  locationId            String?
  authMethod            AuthMethod                @default(CARD)
  cardAssignedAt        DateTime?
  cardDisabledAt        DateTime?
  cardUid               String?                   @unique
  department            String?
  employeeCode          String?                   @unique
  hasMobile             Boolean                   @default(false)
  cardOtpFailedCount    Int                       @default(0)
  cardOtpLocked         Boolean                   @default(false)
  phoneNumber           String?
  requireOtpForCard     Boolean                   @default(false)
  employeeType          EmployeeType              @default(INTERNAL)
  positionId            String?
  // Company the user belongs to. Nullable so existing users stay valid;
  // required for EXTERNAL users (enforced in application logic, not the DB,
  // so legacy rows never break the migration).
  companyId             String?
  mustChangePassword    Boolean                   @default(true)
  passwordChangedAt     DateTime?
  tokenVersion          Int                       @default(0)
  // Account activation (Stage 3). Defaults keep every EXISTING user activated.
  isActivated           Boolean                   @default(true)
  activatedAt           DateTime?
  lastActivationEmailAt DateTime?
  activationEmailStatus String?
  activationEmailError  String?
  attendances           Attendance[]
  adjustmentLogs        AttendanceAdjustmentLog[]
  otps                  AttendanceOtp[]
  mobileTokens          MobileAttendanceToken[]
  kioskQrChallenges     KioskQrChallenge[]
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  securityTokens        UserSecurityToken[]
  clockAttempts         ClockAttempt[]
  location              Location?                 @relation(fields: [locationId], references: [id])
  position              Position?                 @relation(fields: [positionId], references: [id])
  company               Company?                  @relation(fields: [companyId], references: [id])
  devices               UserDevice[]

  @@index([locationId])
  @@index([cardUid])
  @@index([employeeCode])
  @@index([phoneNumber])
  @@index([companyId])
  @@index([positionId])
}

model Position {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Attendance {
  id                     String                    @id @default(uuid())
  userId                 String
  clockIn                DateTime
  clockOut               DateTime?
  latitude               Float?
  longitude              Float?
  // Clock-OUT geolocation (Stage 2). All nullable so historical rows stay valid.
  // NOTE: clockOutCapturedAt is the GPS-fix timestamp from the device, NOT the
  // official clock-out time. The official clock-out time is always `clockOut`,
  // generated by the backend (server clock) — never trusted from the phone.
  clockOutLatitude       Float?
  clockOutLongitude      Float?
  clockOutAccuracyMeters Float?
  clockOutLocationId     String?
  clockOutGeofenceStatus String?
  clockOutCapturedAt     DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  isEdited               Boolean                   @default(false)
  kioskInId              String?
  kioskOutId             String?
  methodIn               AttendanceMethod?
  methodOut              AttendanceMethod?
  notes                  String?
  // Actual clock-IN location (server-resolved). For kiosk events this is
  // derived from the kiosk's own locationId — NOT the employee's assigned
  // User.locationId, and NOT trusted from any client payload.
  clockInLocationId      String?
  // Historical company snapshot: the company the employee belonged to WHEN
  // this attendance record was created (clock-in). Reports attribute the shift
  // to this company even if the user later moves companies. Nullable; legacy
  // rows fall back to the user's current company for display only.
  companyId              String?
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adjustmentLogs         AttendanceAdjustmentLog[]
  clockInLocation        Location?                 @relation("AttendanceClockInLocation", fields: [clockInLocationId], references: [id])
  clockOutLocation       Location?                 @relation("AttendanceClockOutLocation", fields: [clockOutLocationId], references: [id])
  kioskIn                Kiosk?                    @relation("AttendanceKioskIn", fields: [kioskInId], references: [id])
  kioskOut               Kiosk?                    @relation("AttendanceKioskOut", fields: [kioskOutId], references: [id])
  company                Company?                  @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([clockIn])
  @@index([clockOut])
  @@index([kioskInId])
  @@index([kioskOutId])
  @@index([clockInLocationId])
  @@index([clockOutLocationId])
  @@index([companyId])
}

model AttendanceAdjustmentLog {
  id           String            @id @default(uuid())
  attendanceId String
  changedById  String
  oldClockIn   DateTime?
  oldClockOut  DateTime?
  newClockIn   DateTime?
  newClockOut  DateTime?
  oldLatitude  Float?
  oldLongitude Float?
  newLatitude  Float?
  newLongitude Float?
  reason       String
  createdAt    DateTime          @default(now())
  newMethodIn  AttendanceMethod?
  newMethodOut AttendanceMethod?
  oldMethodIn  AttendanceMethod?
  oldMethodOut AttendanceMethod?
  attendance   Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  changedBy    User              @relation(fields: [changedById], references: [id])

  @@index([attendanceId])
  @@index([changedById])
}

model Location {
  id                  String         @id @default(uuid())
  name                String         @unique
  latitude            Float
  longitude           Float
  radiusMeters        Int            @default(150)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  users               User[]
  kiosks              Kiosk[]        @relation("KioskLocation")
  clockInAttendances  Attendance[]   @relation("AttendanceClockInLocation")
  clockOutAttendances Attendance[]   @relation("AttendanceClockOutLocation")
  clockAttempts       ClockAttempt[]
}

model UserDevice {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  platform   String
  isTrusted  Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Kiosk {
  id                  String             @id @default(uuid())
  name                String
  // Legacy free-text label (kept for backward compatibility). The
  // authoritative physical location is `locationId` / `locationRef`.
  location            String?
  locationId          String?
  deviceKey           String             @unique
  isActive            Boolean            @default(true)
  lastSeenAt          DateTime?
  // Optional diagnostics reported by the kiosk on POST /kiosk/config.
  appVersion          String?
  deviceInfo          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  qrChallenges        KioskQrChallenge[]
  enrollments         KioskEnrollment[]
  locationRef         Location?          @relation("KioskLocation", fields: [locationId], references: [id])
  clockInAttendances  Attendance[]       @relation("AttendanceKioskIn")
  clockOutAttendances Attendance[]       @relation("AttendanceKioskOut")
  clockAttempts       ClockAttempt[]

  @@index([locationId])
}

/// Short-lived, single-use challenge displayed as a QR on the kiosk and
/// consumed by the employee phone (kiosk-displays / phone-scans flow).
/// Follows the MobileAttendanceToken pattern: only the SHA-256 hash of
/// the token is stored.
model KioskQrChallenge {
  id           String               @id @default(uuid())
  kioskId      String
  tokenHash    String               @unique
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  action       AttendanceOtpAction?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  kiosk        Kiosk                @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  usedByUser   User?                @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([kioskId])
  @@index([expiresAt])
  @@index([usedAt])
}

model AttendanceOtp {
  id        String              @id @default(uuid())
  userId    String
  kioskId   String
  cardUid   String
  codeHash  String
  action    AttendanceOtpAction
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kioskId])
  @@index([cardUid])
  @@index([expiresAt])
  @@index([usedAt])
}

model MobileAttendanceToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([usedAt])
}

/// Email password-reset tokens: only the SHA-256 hash is stored,
/// 15-minute expiry, single use.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Purpose-scoped single-use security tokens (Stage 3). Only the SHA-256 hash
/// is stored; the raw token is never persisted or logged. Used for account
/// activation now; PASSWORD_RESET is reserved for a future consolidation and
/// is NOT used yet (password reset stays on PasswordResetToken).
model UserSecurityToken {
  id            String               @id @default(uuid())
  userId        String
  purpose       SecurityTokenPurpose
  tokenHash     String               @unique
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Long-lived refresh tokens: only the SHA-256 hash is stored,
/// rotated on use, revoked on password change/reset/logout.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
}

/// Every kiosk clock attempt (success or failure). Failed CLOCK_IN attempts
/// are the qualifying signal for the manager clock-in override. `resolvedAt`
/// is set when a later successful clock-in (or a manager override) resolves
/// the sequence so it can never be reused. `action` reuses AttendanceOtpAction.
model ClockAttempt {
  id           String              @id @default(uuid())
  userId       String
  kioskId      String?
  locationId   String?
  action       AttendanceOtpAction
  successful   Boolean
  reason       String?
  resolvedAt   DateTime?
  resolvedById String?
  attemptedAt  DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kiosk        Kiosk?              @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  location     Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([userId, attemptedAt])
  @@index([locationId, attemptedAt])
  @@index([userId, action, successful, resolvedAt])
}

/// Permanent audit of a manager clock-in override. Intentionally stores plain
/// ids (no cascading relations) so the audit trail is NEVER deleted when an
/// attendance record is later edited or removed.
model ManagerOverrideAudit {
  id                       String              @id @default(uuid())
  employeeId               String
  managerId                String
  attendanceId             String?
  locationId               String?
  action                   AttendanceOtpAction @default(CLOCK_IN)
  reason                   String
  qualifyingFailedAttempts Int
  failedAttemptIds         Json?
  createdAt                DateTime            @default(now())

  @@index([employeeId])
  @@index([managerId])
  @@index([attendanceId])
}

/// First-class company/organisation. External employees must belong to one
/// (enforced in application logic). Companies are never hard-deleted while
/// users or attendance reference them — deactivate instead. The optional
/// relations use the Prisma default ON DELETE SET NULL, so removing a company
/// (should it ever happen) never deletes users or attendance records.
model Company {
  id          String       @id @default(uuid())
  name        String       @unique
  shortName   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  attendances Attendance[]

  @@index([isActive])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AuthMethod {
  CARD
  MOBILE_QR
  MANUAL
}

enum AttendanceMethod {
  CARD
  MOBILE_QR
  MANUAL
  MANAGER_OVERRIDE
  ADMIN_OVERRIDE
  MOBILE_GPS
  /// Written only by AttendanceAutoCloseService when the nightly job closes a
  /// shift the employee never clocked out of. Never accepted from a client.
  AUTO_CLOSE
}

enum AttendanceOtpAction {
  CLOCK_IN
  CLOCK_OUT
}

enum EmployeeType {
  INTERNAL
  EXTERNAL
}

enum SecurityTokenPurpose {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

/// Lifecycle of a self-service kiosk enrollment (universal APK). A freshly
/// installed tablet requests a one-time registration code (PENDING). An admin
/// assigns a name + Location and APPROVES it, at which point a device secret
/// (Kiosk.deviceKey) is generated. The tablet fetches that secret exactly once
/// and CONSUMES the enrollment. Codes expire and are single-use.
enum KioskEnrollmentStatus {
  PENDING
  APPROVED
  CONSUMED
  REJECTED
  EXPIRED
}

/// A pending/handled kiosk enrollment request. The registration code is never
/// stored in plaintext — only its SHA-256 hash (`codeHash`) plus the last 4
/// characters (`codeLast4`) for non-secret admin display. The device secret is
/// the linked Kiosk.deviceKey and is delivered to the tablet only while the
/// enrollment is APPROVED and not yet CONSUMED.
model KioskEnrollment {
  id            String                @id @default(uuid())
  codeHash      String                @unique
  codeLast4     String
  status        KioskEnrollmentStatus @default(PENDING)
  deviceModel   String?
  deviceSerial  String?
  appVersion    String?
  kioskId       String?
  approvedById  String?
  approvedAt    DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  kiosk         Kiosk?                @relation(fields: [kioskId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([kioskId])
  @@index([deviceSerial])
}
